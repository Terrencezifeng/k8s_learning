[node2] Migrate pod networking to Flannel
set -e
test -s /etc/cni/net.d/10-flannel.conflist
test -x /opt/cni/bin/flannel
systemctl stop kubelet
trap 'systemctl start kubelet' EXIT
python - <<'PY'
import json, subprocess
cri = ['crictl', '--runtime-endpoint', 'unix:///run/containerd/containerd.sock']
pods = json.loads(subprocess.check_output(cri + ['pods','--state','Ready','-o','json'])).get('items',[])
for pod in pods:
    detail = json.loads(subprocess.check_output(cri + ['inspectp',pod['id']]))
    mode = detail['status']['linux']['namespaces']['options']['network']
    if mode == 'POD':
        print('Recreate pod network: ' + pod['metadata']['namespace'] + '/' + pod['metadata']['name'])
        subprocess.check_call(cri + ['stopp',pod['id']])
    elif mode != 'NODE':
        raise RuntimeError('Unexpected network mode: ' + str(mode))
PY
if ip link show cni0 >/dev/null 2>&1; then
  ip link delete cni0
fi
rm -f /etc/cni/net.d/10-containerd-net.conflist
chown root:root /etc/cni/net.d /etc/cni/net.d/10-flannel.conflist
chmod 755 /etc/cni/net.d
chmod 644 /etc/cni/net.d/10-flannel.conflist
systemctl restart containerd
systemctl start kubelet
trap - EXIT
systemctl is-active containerd kubelet
ls -l /etc/cni/net.d

