python - <<'PY'
import json, subprocess
cri = ['crictl', '--runtime-endpoint', 'unix:///run/containerd/containerd.sock']
pods = json.loads(subprocess.check_output(cri + ['pods','--state','Ready','-o','json'])).get('items',[])
for pod in pods:
    detail = json.loads(subprocess.check_output(cri + ['inspectp',pod['id']]))
    mode = detail['status']['linux']['namespaces']['options']['network']
    if mode == 'POD':
        print('Recreate pod network: ' + pod['metadata']['namespace'] + '/' + pod['metadata']['name'])
        subprocess.check_call(cri + ['stopp',pod['id']])
    elif mode != 'NODE':
        raise RuntimeError('Unexpected network mode: ' + str(mode))
PY
